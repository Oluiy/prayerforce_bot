datasource db {
  provider = "postgresql"
  url     = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  binaryTargets        = ["native", "debian-openssl-3.0.x"]
}

model User {
  id                   String                  @id @default(uuid())
  chatId               String                  @unique
  firstName            String?
  lastName             String?
  birthday             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  payments             Payment[]
  scores               UserScore[]
  cumulativeMonthly    DailyQuizCumulative[]
  loveLetterDeliveries LoveLetterDelivery[]
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  reference String
  status    String
  email     String?
  createdAt DateTime @default(now())
}

model CounselRequest {
  id            String    @id @default(uuid())
  telegramId    Int
  username      String?
  phoneNumber   String?
  message       String
  responseDueAt DateTime?
  createdAt     DateTime  @default(now())
}

model Question {
  id        Int      @id @default(autoincrement())
  text      String
  options   Option[]
  quizId    String?
  quiz      Quiz?    @relation(fields: [quizId], references: [id])
}

model Option {
  id         Int      @id @default(autoincrement())
  text       String
  isCorrect  Boolean  @default(false)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
}

model Quiz {
  id         String      @id @default(uuid())
  weekStart  DateTime    @default(now())
  isActive   Boolean     @default(false)
  isClosed   Boolean     @default(false)
  type       String      @default("daily") 
  createdAt  DateTime    @default(now())
  // When this quiz should open and close. Set by the admin when the quiz is
  // created. The schedule sweep (jobs/quiz_jobs.py) acts on these.
  opensAt    DateTime?
  closesAt   DateTime?
  // Telegram id of the admin who closed it ahead of closesAt, if any.
  closedEarlyBy String?
  questions  Question[]
  userScores UserScore[]
}

// A member given admin rights for a limited time. Permanent admins stay in
// .env (ADMIN_IDS); these are the temporary ones.
model AdminGrant {
  id         String    @id @default(uuid())
  telegramId String
  grantedBy  String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?

  @@index([telegramId])
  @@index([expiresAt])
}

// Admin-editable values. Only overrides are stored; defaults live in
// config/constants.py via services/settings_service.py.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

model UserScore {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  quizId            String
  quiz              Quiz     @relation(fields: [quizId], references: [id])
  score             Int
  timeTakenSeconds  Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([userId, quizId])
}

model DailyQuizCumulative {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  timeTakenSeconds Int  @default(0)
  monthYear   String   // Format: "2026-05" to group by month
  cumulativeScore Int  @default(0)
  totalQuizzesCompleted Int @default(0)
  lastUpdated DateTime @default(now()) @updatedAt

  @@unique([userId, monthYear])
}

// One love letter. Letters are written per week, so each row carries the week
// it belongs to and a send only draws from the current week's set.
model LoveLetter {
  id        String   @id @default(uuid())
  body      String
  weekKey   String   // e.g. "2026-W45", computed in TIMEZONE
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries LoveLetterDelivery[]

  @@index([weekKey, isActive])
}

// Every letter that went out, so we can report on a send and avoid serving the
// same member twice in a week. `kind` is "weekly" (one per member per week) or
// "direct" (an extra letter an admin sent to one person).
model LoveLetterDelivery {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  letterId String
  letter   LoveLetter @relation(fields: [letterId], references: [id])
  kind     String   @default("weekly")
  weekKey  String?  // null for direct sends, which don't use up the week
  batchId  String   // groups one send run together for reporting
  sentAt   DateTime @default(now())

  // Postgres treats NULLs as distinct, so direct sends never collide here.
  @@unique([userId, weekKey, kind])
  @@index([batchId])
  @@index([weekKey, kind])
}
